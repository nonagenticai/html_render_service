<!DOCTYPE html>
<html lang="{{ lang }}" data-theme="{{ base_theme }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
{% if google_font %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family={{ google_font | urlencode }}:wght@400;500;600;700&display=swap" rel="stylesheet">
{% endif %}
<style>{{ app_css | safe }}</style>
<style>{{ theme_css | safe }}
body{font-family:var(--brand-font, ui-sans-serif, system-ui, sans-serif)}
.text-brand{color:var(--brand-ink, var(--color-primary))}
.text-on-primary-muted{color:var(--brand-on-primary-muted, var(--color-primary-content))}
.embed-mount{width:100%}
html{scroll-behavior:smooth}
[id]{scroll-margin-top:5rem}
.hero-art{aspect-ratio:4/5;display:flex;align-items:center;justify-content:center;overflow:hidden;
background:radial-gradient(circle at 30% 25%,color-mix(in oklab,var(--color-accent,#f59e0b) 70%,transparent),transparent 55%),
radial-gradient(circle at 75% 80%,color-mix(in oklab,var(--color-secondary,#ec4899) 60%,transparent),transparent 60%),
linear-gradient(135deg,var(--color-primary,#4f46e5),color-mix(in oklab,var(--color-primary,#4f46e5) 55%,#000))}</style>
</head>
<body>
{{ body | safe }}
{% if htmx_js %}<script>{{ htmx_js | safe }}</script>{% endif %}
{% if alpine_js %}<script defer>{{ alpine_js | safe }}</script>{% endif %}
</body>
</html>
