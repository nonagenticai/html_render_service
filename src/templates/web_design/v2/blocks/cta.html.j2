<section{% if section_id %} id="{{ section_id }}"{% endif %} class="py-16 md:py-20 px-4 bg-primary text-primary-content">
  <div class="max-w-3xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-bold">{{ block.headline }}</h2>
    {% if block.subheading %}<p class="mt-4 text-lg text-on-primary-muted">{{ block.subheading }}</p>{% endif %}
    <div class="mt-8">
      <a href="{{ block.primary_href | safe_url }}" class="btn btn-lg bg-base-100 text-base-content border-0">{{ block.primary_label }}</a>
    </div>
  </div>
</section>
